#include "typeglide.dtsi"
#include <dt-bindings/gpio/gpio.h>

// Right half — mirrored physically but same GPIO structure
// col 0 = index (innermost), col 1 = middle, col 2 = ring (outermost)
// ZMK split driver offsets these to global cols 3-5 automatically.
// row 3 col 0 = thumb, row 3 col 2 = pinky, row 3 col 1 = spare (no key)
// TODO: adjust pin numbers to match your PCB routing

/ {
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row 0 (top)
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row 1
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row 2
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row 3 (thumb + pinky)
            ;

        col-gpios
            = <&pro_micro 8  GPIO_ACTIVE_HIGH>  // col 0 — index
            , <&pro_micro 9  GPIO_ACTIVE_HIGH>  // col 1 — middle
            , <&pro_micro 10 GPIO_ACTIVE_HIGH>  // col 2 — ring
            ;
    };
};
