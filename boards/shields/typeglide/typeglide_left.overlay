
#include "typeglide.dtsi"
#include "joystick.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <input/processors/rotate_plane.dtsi>


/*
 * Left half
 *
 * col 0 = ring (outermost)
 * col 1 = middle
 * col 2 = index (innermost)
 *
 * row 3 col 0 = pinky
 * row 3 col 2 = thumb
 * row 3 col 1 = spare
 */

 / {
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "row2col";

        row-gpios
            = <&pro_micro 4 GPIO_ACTIVE_HIGH>
            , <&pro_micro 5 GPIO_ACTIVE_HIGH>
            , <&pro_micro 6 GPIO_ACTIVE_HIGH>
            , <&pro_micro 7 GPIO_ACTIVE_HIGH>
            ;

        col-gpios
            = <&pro_micro 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};


/*
 * Rotate the pointing device for the left half.
 */

&zip_rotate_pointer {
    angle = <180>;
};


/*
 * Split pointing input.
 *
 * This is the PMW3610 coming from the right half.
 */

&m_split_listener {
    status = "okay";
    input-processors = <&zip_rotate_pointer>;
};


/*
 * Local joystick.
 *
 * The left half is central, so its joystick is processed locally.
 *
 * &joystick is ONE analog input device containing:
 *
 *     INPUT_ABS_X
 *     INPUT_ABS_Y
 *
 * The Typeglide processor keeps the X/Y state and converts it
 * into one of:
 *
 *     RIGHT
 *     LEFT
 *     DOWN
 *     UP
 */

 / {
    joystick_listener {
        compatible = "zmk,input-listener";
        device = <&joystick>;
        input-processors = <&joystick_4way>;
    };
};


/*
 * Right-half joystick split transport.
 *
 * The right peripheral sends the COMPLETE joystick device
 * (both X and Y events) through one input-split device.
 *
 * reg 0 = PMW3610
 * reg 1 = joystick
 */

 / {

    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        right_joystick_split: right_joystick_split@1 {
            compatible = "zmk,input-split";
            reg = <1>;
        };
    };

    /*
     * Process the right joystick centrally.
     *
     * Both INPUT_ABS_X and INPUT_ABS_Y arrive through the same
     * input device, allowing joystick_4way to maintain the
     * correct X/Y state.
     */

    right_joystick_listener {
        compatible = "zmk,input-listener";
        device = <&right_joystick_split>;
        input-processors = <&joystick_4way>;
    };
};
