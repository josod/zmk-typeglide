#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/adc/adc.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <4>;
        // 4 rows x 3 cols per half, combined 4 rows x 6 cols
        // Left cols 0-2, right cols 3-5
        // col 0 = ring (outer), col 1 = middle, col 2 = index (inner)
        //
        // Physical layout (left | right):
        //
        //  ring  mid   idx  |  idx   mid   ring
        //  ring  mid   idx  |  idx   mid   ring
        //  ring  mid   idx  |  idx   mid   ring
        //  pinky [X]  thumb | thumb  [X]  pinky
        //
        // [X] = spare (no key at row3,col1 on either half)
        map = <
            RC(0,0) RC(0,1) RC(0,2)   RC(0,3) RC(0,4) RC(0,5)
            RC(1,0) RC(1,1) RC(1,2)   RC(1,3) RC(1,4) RC(1,5)
            RC(2,0) RC(2,1) RC(2,2)   RC(2,3) RC(2,4) RC(2,5)
            RC(3,0) RC(3,2)           RC(3,3) RC(3,5)
        >;
    };


};

/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        m_split_input: m_split_input@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };



    m_split_listener: m_split_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&m_split_input>;
     //   input-processors = <&zip_rotate_pointer>;

    };
};
