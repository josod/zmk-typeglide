#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>


#define M_L 1
#define S_L 2

/ {


    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp A  &kp B  &kp C      &kp D  &kp E  &kp F
                &kp G  &mo S_L  &kp I      &kp J  &kp K  &kp L
         &kp S  &kp M  &kp N  &kp O      &kp P  &kp Q  &kp R  &kp V
                              &kp T      &mo M_L
            >;
        };

        mouse_layer {
            bindings = <
                &none &none &none        &none  &none &none
                &none &none &none        &mkp LCLK  &mkp RCLK  &none
          &none &none &none &none        &none &none &none &none
                            &none        &none
            >;
        };


        scroll_layer {
            bindings = <
                &none &none &none        &none &none &none
                &none &none &none        &none &none &none
          &none &none &none &none        &none &none &none &none
                            &none        &none
            >;
        };

    };
};
