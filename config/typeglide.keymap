#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/caps_word.dtsi>



// Left hand: 11 keys
#define LTR  0   // Left Top Ring
#define LTM  1   // Left Top Middle
#define LTI  2   // Left Top Index

#define LMR  6   // Left Middle Ring
#define LMM  7   // Left Middle Middle
#define LMI  8   // Left Middle Index

#define LBP 12   // Left Bottom Pinky
#define LBR 13   // Left Bottom Ring
#define LBM 14   // Left Bottom Middle
#define LBI 15   // Left Bottom Index

#define LMT 20   // Left Middle Thumb


// Right hand: 11 keys
#define RTI  3   // Right Top Index
#define RTM  4   // Right Top Middle
#define RTR  5   // Right Top Ring

#define RMI  9   // Right Middle Index
#define RMM 10   // Right Middle Middle
#define RMR 11   // Right Middle Ring

#define RBI 16   // Right Bottom Index
#define RBM 17   // Right Bottom Middle
#define RBR 18   // Right Bottom Ring
#define RBP 19   // Right Bottom Pinky

#define RMT 21   // Right Middle Thumb


// Layers
#define A1_L 0   // Alfa 1
#define A2_L 1   // Alfa 2
#define SC_L 2
//#define X_L 3
//#define Y_L 4
#define MO_L 3   // Mouse  REMEMBER: change layer active on left overlay


#define EURKEY(name, key)                                      \
    name: name {                                                \
        compatible = "zmk,behavior-macro";                     \
        #binding-cells = <0>;                                  \
        bindings =                                               \
            <&macro_press &kp RALT>,                            \
            <&macro_tap &kp key>,                              \
            <&macro_release &kp RALT>;                         \
    };


#define COMBO(name, pos0, pos1, behavior, ...) \
    name { \
        timeout-ms = <50>; \
        key-positions = <pos0 pos1>; \
        layers = <__VA_ARGS__>; \
        bindings = <behavior>; \
    };

#define HOLD_TAP(name, flavor_, tap_term, bind0, bind1) \
    name: name { \
        compatible = "zmk,behavior-hold-tap"; \
        #binding-cells = <2>; \
        flavor = flavor_; \
        tapping-term-ms = <tap_term>; \
        bindings = bind0, bind1; \
    };

/ {

 //          SIDE:L(left)/R(right)
 //          ROW:T(top)/M(middle)/B(bottom)/M(mouse)
 //          FINGER:P(pinky)/R(ring)/M(middle)/I(index)/T(thumb)
 //
 //          POS: SIDE-ROW-FINGER
 //
 //          bindings = <
 //               LTR    LTM    LTI                            RTI    RTM   RTR
 //               LMR    LMM    LMI                            RMI    RMM   RMR
 //          LBP  LBR    LBM    LBI      Joy        Joy        RBI    RBM   RBR   RBP
 //                             LMT                            RMT



    behaviors {

        TPHLS: TPHLS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&sl>;
        };

        TPHL: TPHL {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        HOLD_TAP(HT_KP_KP_BAL, "balanced", 200, <&kp>, <&kp>)

        caps_word_or_scroll_right: caps_word_or_scroll_right {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&caps_word>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
    };



    macros {
        EURKEY(swe_aa, W)
        EURKEY(swe_ae, A)
        EURKEY(swe_oe, O)
    };

    combos {
        compatible = "zmk,combos";

        COMBO(_backspace, RMM, RMR, &kp BACKSPACE, A1_L)
    };

    keymap {
        compatible = "zmk,keymap";


// ------------------------------------------LEFT-------------------------------------------------------<>-----------------------------------------------RIGHT-----------------------------------------------------------------
// Pinky                    Ring                        Middle                      Index               <>      Index                       Middle                      Ring                        Pinky
//------------------------------------------------------------------------------------------------------<>----------------------------------------------------------------------------------------------------------------------
        A1_layer {
            bindings = <
                            &caps_word                  &kp D                       &kp G                       &kp F                       &kp O                       &kp U
                            &HT_KP_KP_BAL LALT   R      &HT_KP_KP_BAL LCTRL  T      &HT_KP_KP_BAL LSHIFT S      &HT_KP_KP_BAL RSHIFT H      &HT_KP_KP_BAL RCTRL  A      &HT_KP_KP_BAL RALT   E
&kp N                       &kp W                       &kp M                       &kp C                       &kp P                       &kp COMMA                   &kp DOT                     &lt MO_L I
                                                                                    &TPHL SC_L SPACE            &TPHLS SC_L A2_L
            >;
        };

        A2_layer {
            bindings = <
                            &none                       &kp Q                       &kp X                       &swe_aa                     &swe_ae                     &swe_oe
                            &kp J                       &kp B                       &kp Y                       &kp V                       &kp K                       &kp DQT
&kp Z                       &none                       &none                       &none                       &kp MINUS                   &kp COLON                   &kp UNDER                   &kp SEMI
                                                                                    &none                       &none
            >;
        };


        SC_layer {
            bindings = <
                &none &none &kp N4       &none &none &none
                &none &none &none        &none &none &none
          &none &none &none &none        &none &none &none &none
                            &none        &none
            >;
        };

/*
        X_layer {
            bindings = <
                &kp X &none &none        &none &none &none
                &none &none &none        &none &none &none
          &none &none &none &none        &none &none &none &none
                            &none        &none
            >;
        };

        Y_layer {
            bindings = <
                &kp Y &none &none        &none &none &none
                &none &none &none        &none &none &none
          &none &none &none &none        &none &none &none &mo MO_L
                            &none        &none
            >;
        };
*/
        MO_layer {
            bindings = <
                &none &kp N7  &none        &none      &none       &none
                &none &none &none        &mkp LCLK  &mkp RCLK   &none
          &none &none &none &none        &none      &none &none &none
                            &none        &none
            >;
        };

    };

};

&caps_word {
    continue-list = <SPACE UNDERSCORE BSPC DEL>;
};
